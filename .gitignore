# Compilação e caches do Julia
*.jl.cov
*.jl.*.cov
*.jl.mem
*.jl.*.mem

# Ambientes locais e credenciais (ex: PhysioNet tokens)
.env
.env.*
secrets.toml
credentials.json

# Proteção de dados do MIMIC-IV e arquivos tabulares pesados/sensíveis
*.csv
*.csv.gz
*.parquet
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep

# Saídas e plots temporários
/output/*
!/output/.gitkeep

# IDEs e Editores
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini

# Checkpoints de Notebooks
.ipynb_checkpoints/
.pluto.jl

# Artefatos de execução e dados derivados
*.log
*.jld2
*.bson
*.tmp
*.swp
/docs/build/
.julia/
